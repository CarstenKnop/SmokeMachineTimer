<UserControl x:Class="FogConsole.Views.ChannelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FogConsole.Controls"
             xmlns:cv="clr-namespace:FogConsole.Converters"
             xmlns:vm="clr-namespace:FogConsole.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="MigrationTemplate" DataType="{x:Type vm:MigrationItemViewModel}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="{cv:ToneBrush Path=Status}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Fog.Icon}">
                            <Setter Property="FontSize" Value="15"/>
                            <Setter Property="Text" Value="&#xE916;"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Confirmed"><Setter Property="Text" Value="&#xE73E;"/></DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Text" Value="&#xEA39;"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Fog.Label}" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource Fog.Caption}" Foreground="{cv:ToneBrush Path=Status}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LabResultTemplate" DataType="{x:Type vm:LinkTestResultViewModel}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeText}" Style="{StaticResource Fog.MonoDim}"/>
                <TextBlock Grid.Column="1" Text="{Binding DeviceName}" Style="{StaticResource Fog.Label}"/>
                <TextBlock Grid.Column="2" Text="{Binding ChannelText}" Style="{StaticResource Fog.Mono}" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="3" Text="{Binding SuccessText}" Style="{StaticResource Fog.Mono}" ToolTip="Pings answered by the timer"/>
                <TextBlock Grid.Column="4" Text="{Binding AckText}" Style="{StaticResource Fog.MonoDim}" ToolTip="Frames acknowledged by the timer's radio"/>
                <TextBlock Grid.Column="5" Text="{Binding RttText}" Style="{StaticResource Fog.MonoDim}"/>
                <TextBlock Grid.Column="6" Text="{Binding RssiText}" Style="{StaticResource Fog.MonoDim}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="24,18,24,28" MaxWidth="1300" HorizontalAlignment="Stretch">
            <TextBlock Text="Channels" Style="{StaticResource Fog.PageTitle}"/>
            <TextBlock Style="{StaticResource Fog.PageSubtitle}"
                       Text="The remote and its timers talk on one 2.4 GHz channel that they share with Wi-Fi networks. Measure how busy each channel is, move the whole system to a quiet one, and compare the real link quality before and after."/>

            <Border Style="{StaticResource Fog.Card}" Margin="0,0,0,16" Visibility="{Binding IsDirectTimer, Converter={x:Static cv:Conv.BoolToVisibility}}">
                <TextBlock Style="{StaticResource Fog.Body}" Text="A timer is connected directly by USB. The channel tools belong to the remote and are not available here."/>
            </Border>

            <StackPanel Visibility="{Binding IsDirectTimer, Converter={x:Static cv:Conv.InverseBoolToVisibility}}">

                <!-- ===== survey ===== -->
                <Border Style="{StaticResource Fog.Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource Fog.Button.Accent}" Command="{Binding SurveyCommand}" Padding="20,10" AutomationProperties.Name="Survey channels"
                                    ToolTip="Listen on all 13 channels for about 3 seconds. The radio is busy meanwhile.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource Fog.Icon}" FontSize="15" Margin="0,0,9,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="Survey channels"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SurveyStatus}" Style="{StaticResource Fog.Caption}" TextWrapping="Wrap" TextTrimming="None"/>
                                <ProgressBar Minimum="0" Maximum="13" Value="{Binding SurveyDone, Mode=OneWay}" Height="4" Margin="0,7,0,0"
                                             Visibility="{Binding IsSurveying, Converter={x:Static cv:Conv.BoolToVisibility}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="System channel" Style="{StaticResource Fog.Caption}" Margin="0,0,8,0"/>
                                <Border Style="{StaticResource Fog.Chip.Accent}" Padding="12,4">
                                    <TextBlock Text="{Binding HomeChannel}" Style="{StaticResource Fog.ChipText.Accent}" FontSize="15"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding Recommendation}" Style="{StaticResource Fog.Body}" Margin="0,12,0,0"
                                   Visibility="{Binding Recommendation, Converter={x:Static cv:Conv.NullToCollapsed}}" FontWeight="SemiBold"/>

                        <c:ChannelHeatMap Height="290" Margin="0,12,0,0" Cells="{Binding Cells}" SelectedChannel="{Binding SelectedChannel, Mode=TwoWay}"
                                          QuietBrush="{DynamicResource Fog.HeatQuiet}" BusyBrush="{DynamicResource Fog.HeatBusy}" JammedBrush="{DynamicResource Fog.HeatJam}" RankBrush="{DynamicResource Fog.Ok}"
                                          AccentBrush="{DynamicResource Fog.Accent}" TrackBrush="{DynamicResource Fog.Track}" TextBrush="{DynamicResource Fog.Text}"
                                          DimTextBrush="{DynamicResource Fog.TextFaint}" AutomationProperties.Name="Channel quality chart"
                                          ToolTip="Click a channel to choose it as the target. Bar height and colour show how busy the channel is (lower = quieter)."/>

                        <WrapPanel Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,4">
                                <Border Width="90" Height="10" CornerRadius="5" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="{DynamicResource Fog.HeatQuiet.Color}" Offset="0"/>
                                            <GradientStop Color="{DynamicResource Fog.HeatBusy.Color}" Offset="0.5"/>
                                            <GradientStop Color="{DynamicResource Fog.HeatJam.Color}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="score 0 (quiet) to 100 (busy)" Style="{StaticResource Fog.Caption}"/>
                            </StackPanel>
                            <TextBlock Text="CURRENT = channel in use" Style="{StaticResource Fog.Caption}" Margin="0,0,20,4" Foreground="{DynamicResource Fog.Accent}"/>
                            <TextBlock Text="&#x2605; #1 #2 #3 = recommended" Style="{StaticResource Fog.Caption}" Margin="0,0,20,4" Foreground="{DynamicResource Fog.Ok}"/>
                            <TextBlock Text="below each bar: Wi-Fi networks and the strongest one" Style="{StaticResource Fog.Caption}" Margin="0,0,0,4"/>
                        </WrapPanel>

                        <Rectangle Style="{StaticResource Fog.Separator}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource Fog.Button}" Command="{Binding MoveCommand}" Padding="18,10" AutomationProperties.Name="Move the system to the selected channel">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8AB;" Style="{StaticResource Fog.Icon}" FontSize="15" Margin="0,0,9,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="{Binding MoveButtonText}"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding ForceMove}" Content="Force: move even if no timer confirms" ToolTip="Dangerous: the remote may end up on a channel where no timer listens."/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Fog.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="None"
                                   Text="Pick a column above, then press the button. You will be asked to confirm; the change takes a few seconds and every online timer follows."/>

                        <!-- migration progress -->
                        <Border Style="{StaticResource Fog.Tile}" Margin="0,14,0,0" Padding="14,10"
                                Visibility="{Binding MigrationSummary, Converter={x:Static cv:Conv.NullToCollapsed}}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding MigrationSummary}" Style="{StaticResource Fog.Label}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,40,0"/>
                                </Grid>
                                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,4" Visibility="{Binding MigrationActive, Converter={x:Static cv:Conv.BoolToVisibility}}"/>
                                <ItemsControl ItemsSource="{Binding MigrationItems}" ItemTemplate="{StaticResource MigrationTemplate}" Margin="0,6,0,0" Focusable="False"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== recover ===== -->
                <Border Style="{StaticResource Fog.Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="LOST TIMERS" Style="{StaticResource Fog.Overline}"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource Fog.Button}" Command="{Binding RecoverCommand}" Padding="18,10" AutomationProperties.Name="Find lost timers">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" Style="{StaticResource Fog.Icon}" FontSize="15" Margin="0,0,9,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="Find lost timers"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Style="{StaticResource Fog.Caption}" TextWrapping="Wrap" TextTrimming="None"
                                       Text="A timer that missed a channel change (it was powered off while heating up) comes back on the old channel and stays offline. The remote sweeps all channels and brings it home."/>
                        </Grid>
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,12,0,0" Visibility="{Binding IsRecovering, Converter={x:Static cv:Conv.BoolToVisibility}}"/>
                        <ItemsControl ItemsSource="{Binding RecoverLog}" Margin="0,10,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Fog.Label}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ===== link lab ===== -->
                <Border Style="{StaticResource Fog.Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="LINK LAB" Style="{StaticResource Fog.Overline}"/>
                        <TextBlock Style="{StaticResource Fog.DimBody}" Margin="0,6,0,12"
                                   Text="Sends a burst of pings to one timer and measures how many arrive and how fast. Run it on different channels (or distances) and compare the results below."/>
                        <WrapPanel>
                            <StackPanel Margin="0,0,14,8">
                                <TextBlock Text="Timer" Style="{StaticResource Fog.Faint}" Margin="0,0,0,3"/>
                                <ComboBox Width="190" ItemsSource="{Binding Fleet.Devices}" SelectedItem="{Binding LabDevice}" DisplayMemberPath="DisplayName" AutomationProperties.Name="Timer to test"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,8">
                                <TextBlock Text="Packets" Style="{StaticResource Fog.Faint}" Margin="0,0,0,3"/>
                                <ComboBox Width="100" ItemsSource="{Binding CountChoices}" SelectedItem="{Binding LabCount}" AutomationProperties.Name="Number of packets"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,8">
                                <TextBlock Text="Gap (ms)" Style="{StaticResource Fog.Faint}" Margin="0,0,0,3"/>
                                <ComboBox Width="100" ItemsSource="{Binding GapChoices}" SelectedItem="{Binding LabGapMs}" AutomationProperties.Name="Gap between packets in milliseconds"/>
                            </StackPanel>
                            <Button Style="{StaticResource Fog.Button.Accent}" Content="Run test" Command="{Binding RunLinkTestCommand}" VerticalAlignment="Bottom" Margin="0,0,0,8" Padding="22,8"
                                    AutomationProperties.Name="Run link test"/>
                        </WrapPanel>

                        <Border Style="{StaticResource Fog.Tile}" Padding="16,12" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding LabStatus}" Style="{StaticResource Fog.Label}" TextWrapping="Wrap" TextTrimming="None"/>
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding LiveProgress, Mode=OneWay}" Height="6" Margin="0,10,0,10"/>
                                <UniformGrid Columns="4">
                                    <StackPanel><TextBlock Text="Answered (echo)" Style="{StaticResource Fog.Faint}"/><TextBlock Text="{Binding LiveEchoText}" Style="{StaticResource Fog.Digits}" FontSize="26"/></StackPanel>
                                    <StackPanel><TextBlock Text="Acknowledged" Style="{StaticResource Fog.Faint}"/><TextBlock Text="{Binding LiveAckText}" Style="{StaticResource Fog.Digits}" FontSize="26"/></StackPanel>
                                    <StackPanel><TextBlock Text="Round trip" Style="{StaticResource Fog.Faint}"/><TextBlock Text="{Binding LiveRttText}" Style="{StaticResource Fog.Mono}" FontSize="13" Margin="0,8,0,0"/></StackPanel>
                                    <StackPanel><TextBlock Text="Signal" Style="{StaticResource Fog.Faint}"/><TextBlock Text="{Binding LiveRssiText}" Style="{StaticResource Fog.Mono}" FontSize="13" Margin="0,8,0,0"/></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,16,0,6">
                            <TextBlock Text="PREVIOUS TESTS" Style="{StaticResource Fog.Overline}" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource Fog.Button.Subtle}" Content="Clear" HorizontalAlignment="Right" Padding="8,3" FontSize="12" Command="{Binding ClearLabHistoryCommand}"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/><ColumnDefinition Width="110"/><ColumnDefinition Width="56"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Time" Style="{StaticResource Fog.Faint}"/>
                            <TextBlock Grid.Column="1" Text="Timer" Style="{StaticResource Fog.Faint}"/>
                            <TextBlock Grid.Column="2" Text="Channel" Style="{StaticResource Fog.Faint}"/>
                            <TextBlock Grid.Column="3" Text="Success" Style="{StaticResource Fog.Faint}"/>
                            <TextBlock Grid.Column="4" Text="MAC ack" Style="{StaticResource Fog.Faint}"/>
                            <TextBlock Grid.Column="5" Text="RTT avg / max" Style="{StaticResource Fog.Faint}"/>
                            <TextBlock Grid.Column="6" Text="Signal" Style="{StaticResource Fog.Faint}"/>
                        </Grid>
                        <TextBlock Text="No tests yet." Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Fog.Caption}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LabHistory.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding LabHistory}" ItemTemplate="{StaticResource LabResultTemplate}" Focusable="False"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
