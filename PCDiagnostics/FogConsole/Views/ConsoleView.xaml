<UserControl x:Class="FogConsole.Views.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FogConsole.Controls"
             xmlns:cv="clr-namespace:FogConsole.Converters"
             xmlns:vm="clr-namespace:FogConsole.ViewModels">
    <UserControl.Resources>
        <Style x:Key="ConsoleList" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource Fog.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Fog.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource Fog.PlainListItem}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="SelectionMode" Value="Extended"/>
        </Style>

        <DataTemplate x:Key="LogRowTemplate" DataType="{x:Type vm:LogRow}">
            <Grid ToolTip="{Binding Line}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="98"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="82"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeText}" Style="{StaticResource Fog.MonoDim}" FontSize="12"/>
                <TextBlock Grid.Column="1" Text="{Binding LevelText}" Style="{StaticResource Fog.Mono}" FontSize="12" FontWeight="SemiBold" x:Name="Lvl"/>
                <TextBlock Grid.Column="2" Text="{Binding Source}" Style="{StaticResource Fog.MonoDim}" FontSize="12"/>
                <TextBlock Grid.Column="3" Text="{Binding Text}" Style="{StaticResource Fog.Mono}" FontSize="12" x:Name="Msg" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Error">
                    <Setter TargetName="Lvl" Property="Foreground" Value="{DynamicResource Fog.Bad}"/>
                    <Setter TargetName="Msg" Property="Foreground" Value="{DynamicResource Fog.Bad}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warn">
                    <Setter TargetName="Lvl" Property="Foreground" Value="{DynamicResource Fog.Warn}"/>
                    <Setter TargetName="Msg" Property="Foreground" Value="{DynamicResource Fog.Warn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Info">
                    <Setter TargetName="Lvl" Property="Foreground" Value="{DynamicResource Fog.Info}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Debug">
                    <Setter TargetName="Lvl" Property="Foreground" Value="{DynamicResource Fog.TextFaint}"/>
                    <Setter TargetName="Msg" Property="Foreground" Value="{DynamicResource Fog.TextDim}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="PacketRowTemplate" DataType="{x:Type vm:PacketRow}">
            <Grid ToolTip="{Binding Hex}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="98"/>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeText}" Style="{StaticResource Fog.MonoDim}" FontSize="12"/>
                <TextBlock Grid.Column="1" Text="{Binding Arrow}" Style="{StaticResource Fog.Mono}" FontSize="12" FontWeight="SemiBold" x:Name="Dir" Foreground="{DynamicResource Fog.Info}"/>
                <TextBlock Grid.Column="2" Text="{Binding Mac}" Style="{StaticResource Fog.Mono}" FontSize="12"/>
                <TextBlock Grid.Column="3" Text="{Binding Kind}" Style="{StaticResource Fog.Mono}" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="4" Text="{Binding Len}" Style="{StaticResource Fog.Mono}" FontSize="12" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="5" Text="{Binding RssiText}" Style="{StaticResource Fog.MonoDim}" FontSize="12" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="6" Text="{Binding Seq}" Style="{StaticResource Fog.MonoDim}" FontSize="12"/>
                <TextBlock Grid.Column="7" Text="{Binding Hex}" Style="{StaticResource Fog.MonoDim}" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Dir}" Value="tx">
                    <Setter TargetName="Dir" Property="Foreground" Value="{DynamicResource Fog.Accent}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="RawRowTemplate" DataType="{x:Type vm:RawRow}">
            <Grid ToolTip="{Binding Text}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="98"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeText}" Style="{StaticResource Fog.MonoDim}" FontSize="12"/>
                <TextBlock Grid.Column="1" Text="{Binding Arrow}" Style="{StaticResource Fog.Mono}" FontSize="12" FontWeight="SemiBold" x:Name="Arrow"/>
                <TextBlock Grid.Column="2" Text="{Binding Text}" Style="{StaticResource Fog.Mono}" FontSize="12" x:Name="Msg" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Direction}" Value="Tx">
                    <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource Fog.Accent}"/>
                    <Setter TargetName="Msg" Property="Foreground" Value="{DynamicResource Fog.Accent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Direction}" Value="Rx">
                    <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource Fog.Info}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="PlainText">
                    <Setter TargetName="Msg" Property="Foreground" Value="{DynamicResource Fog.TextFaint}"/>
                    <Setter TargetName="Msg" Property="FontStyle" Value="Italic"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="MalformedJson">
                    <Setter TargetName="Msg" Property="Foreground" Value="{DynamicResource Fog.Warn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Oversize">
                    <Setter TargetName="Msg" Property="Foreground" Value="{DynamicResource Fog.Bad}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Direction}" Value="Info">
                    <Setter TargetName="Msg" Property="Foreground" Value="{DynamicResource Fog.Sim}"/>
                    <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource Fog.Sim}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Console" Style="{StaticResource Fog.PageTitle}"/>
            <TextBlock Style="{StaticResource Fog.PageSubtitle}" Margin="0,0,0,10"
                       Text="Everything the device says: its log, every radio frame it sees, and the raw lines on the USB cable in both directions (including plain-text boot output)."/>
        </StackPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}" Background="Transparent" BorderThickness="0" Padding="0,10,0,0">
            <!-- ===== LOG ===== -->
            <TabItem Header="Log">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <Grid Margin="0,0,8,6">
                            <TextBox Width="220" Text="{Binding LogFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Only show lines containing this text (message or source)" AutomationProperties.Name="Log filter"/>
                            <TextBlock Text="Filter text..." Style="{StaticResource Fog.Caption}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="{Binding LogFilter, Converter={x:Static cv:Conv.NullToVisible}}"/>
                        </Grid>
                        <ComboBox Width="180" ItemsSource="{Binding LevelFilters}" SelectedIndex="{Binding LevelFilterIndex}" Margin="0,0,8,6" AutomationProperties.Name="Minimum level shown"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,6" VerticalAlignment="Center" ToolTip="Which log events the device sends over USB (logCfg)">
                            <TextBlock Text="Device level" Style="{StaticResource Fog.Caption}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ComboBox Width="90" ItemsSource="{Binding DeviceLogLevels}" SelectedItem="{Binding DeviceLogLevel}" AutomationProperties.Name="Device log level"/>
                        </StackPanel>
                        <CheckBox Content="Auto-scroll" IsChecked="{Binding LogAutoScroll}" Margin="0,0,10,6"/>
                        <ToggleButton Style="{StaticResource Fog.ToggleButton}" Content="Pause" IsChecked="{Binding LogPaused}" Padding="12,5" Margin="0,0,8,6" ToolTip="Freeze the view; lines keep being collected"/>
                        <Button Style="{StaticResource Fog.Button.Small}" Content="Copy" Command="{Binding CopyLogCommand}" Margin="0,0,6,6"/>
                        <Button Style="{StaticResource Fog.Button.Small}" Content="Save..." Command="{Binding SaveLogCommand}" Margin="0,0,6,6"/>
                        <Button Style="{StaticResource Fog.Button.Small}" Content="Clear" Command="{Binding ClearLogCommand}" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <ListBox Grid.Row="1" Style="{StaticResource ConsoleList}" ItemsSource="{Binding LogRows}" ItemTemplate="{StaticResource LogRowTemplate}"
                             c:Behaviors.AutoScroll="{Binding LogAutoScroll}" AutomationProperties.Name="Log"/>
                    <TextBlock Grid.Row="2" Text="{Binding LogCountText}" Style="{StaticResource Fog.Faint}" Margin="2,6,0,0"/>
                </Grid>
            </TabItem>

            <!-- ===== PACKETS ===== -->
            <TabItem Header="Packets">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <ToggleButton Style="{StaticResource Fog.ToggleButton}" IsChecked="{Binding CaptureFrames}" Padding="14,6" Margin="0,0,10,6"
                                      ToolTip="Ask the device to send every radio frame it sends or receives (limited to 30 per second)" AutomationProperties.Name="Capture radio frames">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C8;" Style="{StaticResource Fog.Icon}" FontSize="14" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                <TextBlock Text="Capture frames"/>
                            </StackPanel>
                        </ToggleButton>
                        <Grid Margin="0,0,8,6">
                            <TextBox Width="220" Text="{Binding PacketFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter by MAC, kind (STATUS ...), direction (rx / tx) or hex bytes" AutomationProperties.Name="Packet filter"/>
                            <TextBlock Text="MAC, type, rx/tx, hex..." Style="{StaticResource Fog.Caption}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="{Binding PacketFilter, Converter={x:Static cv:Conv.NullToVisible}}"/>
                        </Grid>
                        <CheckBox Content="Auto-scroll" IsChecked="{Binding PacketAutoScroll}" Margin="0,0,10,6"/>
                        <ToggleButton Style="{StaticResource Fog.ToggleButton}" Content="Pause" IsChecked="{Binding PacketPaused}" Padding="12,5" Margin="0,0,8,6"/>
                        <Button Style="{StaticResource Fog.Button.Small}" Content="Export CSV..." Command="{Binding ExportPacketsCommand}" Margin="0,0,6,6"/>
                        <Button Style="{StaticResource Fog.Button.Small}" Content="Clear" Command="{Binding ClearPacketsCommand}" Margin="0,0,0,6"/>
                    </WrapPanel>
                    <Grid Grid.Row="1" Margin="12,0,12,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="98"/><ColumnDefinition Width="58"/><ColumnDefinition Width="140"/><ColumnDefinition Width="92"/><ColumnDefinition Width="46"/><ColumnDefinition Width="52"/><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Time" Style="{StaticResource Fog.Faint}"/>
                        <TextBlock Grid.Column="1" Text="Dir" Style="{StaticResource Fog.Faint}"/>
                        <TextBlock Grid.Column="2" Text="MAC" Style="{StaticResource Fog.Faint}"/>
                        <TextBlock Grid.Column="3" Text="Type" Style="{StaticResource Fog.Faint}"/>
                        <TextBlock Grid.Column="4" Text="Len" Style="{StaticResource Fog.Faint}" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="5" Text="RSSI" Style="{StaticResource Fog.Faint}" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="6" Text="Seq" Style="{StaticResource Fog.Faint}"/>
                        <TextBlock Grid.Column="7" Text="Bytes (hex)" Style="{StaticResource Fog.Faint}"/>
                    </Grid>
                    <ListBox Grid.Row="2" Style="{StaticResource ConsoleList}" ItemsSource="{Binding PacketRows}" ItemTemplate="{StaticResource PacketRowTemplate}"
                             c:Behaviors.AutoScroll="{Binding PacketAutoScroll}" AutomationProperties.Name="Packets"/>
                    <TextBlock Grid.Row="3" Style="{StaticResource Fog.Faint}" Margin="2,6,0,0">
                        <Run Text="{Binding PacketCountText, Mode=OneWay}"/><Run Text="   -   the capture switch tells the device to stream frames; turn it off when you are done."/>
                    </TextBlock>
                </Grid>
            </TabItem>

            <!-- ===== RAW ===== -->
            <TabItem Header="Raw">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <CheckBox Content="Auto-scroll" IsChecked="{Binding RawAutoScroll}" Margin="0,0,10,6"/>
                        <ToggleButton Style="{StaticResource Fog.ToggleButton}" Content="Pause" IsChecked="{Binding RawPaused}" Padding="12,5" Margin="0,0,8,6"/>
                        <Button Style="{StaticResource Fog.Button.Small}" Content="Copy" Command="{Binding CopyRawCommand}" Margin="0,0,6,6"/>
                        <Button Style="{StaticResource Fog.Button.Small}" Content="Save..." Command="{Binding SaveRawCommand}" Margin="0,0,6,6"/>
                        <Button Style="{StaticResource Fog.Button.Small}" Content="Clear" Command="{Binding ClearRawCommand}" Margin="0,0,14,6"/>
                        <TextBlock Style="{StaticResource Fog.Caption}" VerticalAlignment="Center" Margin="0,0,0,6">
                            <Run Text="&#x2192;" Foreground="{DynamicResource Fog.Accent}" FontWeight="Bold"/><Run Text=" sent to the device    "/>
                            <Run Text="&#x2190;" Foreground="{DynamicResource Fog.Info}" FontWeight="Bold"/><Run Text=" received    "/>
                            <Run Text="grey italic = plain text (boot log)" />
                        </TextBlock>
                    </WrapPanel>
                    <ListBox Grid.Row="1" Style="{StaticResource ConsoleList}" ItemsSource="{Binding RawRows}" ItemTemplate="{StaticResource RawRowTemplate}"
                             c:Behaviors.AutoScroll="{Binding RawAutoScroll}" AutomationProperties.Name="Raw lines"/>
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Width="210" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" Margin="0,0,8,0" AutomationProperties.Name="Command templates"
                                  ToolTip="Insert a ready-made request into the box"/>
                        <TextBox x:Name="RawBox" Grid.Column="1" Text="{Binding RawInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Fog.MonoFont}"
                                 AutomationProperties.Name="JSON line to send" PreviewKeyDown="RawBox_PreviewKeyDown"
                                 ToolTip="One JSON object per line. Enter sends, Up / Down browse the history. A missing id is added for you.">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SendRawCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="2" Style="{StaticResource Fog.Button.Accent}" Content="Send" Margin="8,0,0,0" MinWidth="86" Command="{Binding SendRawCommand}"/>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding RawValidation}" Style="{StaticResource Fog.Faint}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,100,-18"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
