<UserControl x:Class="FogConsole.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FogConsole.Controls"
             xmlns:cv="clr-namespace:FogConsole.Converters"
             xmlns:vm="clr-namespace:FogConsole.ViewModels"
             xmlns:diag="clr-namespace:FogConsole.Diagnostics">
    <UserControl.Resources>
        <!-- one counter -->
        <DataTemplate DataType="{x:Type vm:MetricViewModel}">
            <Border MinWidth="134" Margin="0,0,7,7" ToolTip="{Binding Hint}" AutomationProperties.Name="{Binding Name}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Fog.Tile}">
                        <Setter Property="Padding" Value="11,8"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Warn">
                                <Setter Property="Background" Value="{DynamicResource Fog.WarnSoft}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Fog.Warn}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Bad">
                                <Setter Property="Background" Value="{DynamicResource Fog.BadSoft}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Fog.Bad}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Fog.Faint}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding Value}" FontSize="15" FontWeight="SemiBold" TextTrimming="None">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Fog.Mono}">
                                    <Setter Property="FontSize" Value="15"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="Warn"><Setter Property="Foreground" Value="{DynamicResource Fog.Warn}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Bad"><Setter Property="Foreground" Value="{DynamicResource Fog.Bad}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center" Text="&#xE7BA;">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Fog.Icon}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="Warn">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Fog.Warn}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Bad">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Fog.Bad}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{Binding Rate}" Style="{StaticResource Fog.Faint}" Visibility="{Binding HasRate, Converter={x:Static cv:Conv.BoolToVisibility}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- health verdict chip -->
        <DataTemplate DataType="{x:Type diag:HealthChip}">
            <Border Style="{StaticResource Fog.Chip}" Margin="0,0,6,6" ToolTip="{Binding Detail}" Padding="9,3"
                    Background="{cv:ToneBrush Path=Level, Part=Bg}" BorderBrush="{cv:ToneBrush Path=Level, Part=Border}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Fog.ChipIcon}" Foreground="{cv:ToneBrush Path=Level}">
                        <TextBlock.Text>
                            <Binding Path="Level" Converter="{x:Static cv:Conv.HealthGlyph}"/>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Fog.ChipText}" Foreground="{cv:ToneBrush Path=Level}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="MetricGroupTitle" TargetType="TextBlock" BasedOn="{StaticResource Fog.Overline}">
            <Setter Property="Margin" Value="0,10,0,6"/>
        </Style>

        <!-- one timer -->
        <DataTemplate DataType="{x:Type vm:DeviceDiagnosticsViewModel}">
            <Border Style="{StaticResource Fog.Card}" Margin="0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,18,0">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Fog.Subtitle}" FontSize="16"/>
                            <Border Style="{StaticResource Fog.Chip}" Margin="10,0,0,0">
                                <Border.Resources>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Fog.ChipText}"/>
                                </Border.Resources>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Fog.ChipText}">
                                            <Setter Property="Text" Value="OFFLINE"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Online}" Value="True">
                                                    <Setter Property="Text" Value="online"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Fog.Ok}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Chips}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>

                    <!-- trends over the last 5 minutes -->
                    <UniformGrid Columns="3" Margin="0,6,0,2">
                        <StackPanel Margin="0,0,14,0">
                            <Grid><TextBlock Text="LOSS %" Style="{StaticResource Fog.Overline}"/><TextBlock Text="{Binding LossNow}" Style="{StaticResource Fog.Mono}" HorizontalAlignment="Right" FontSize="12"/></Grid>
                            <c:Sparkline Height="40" Values="{Binding LossHistory}" Minimum="0" Maximum="40" Stroke="{DynamicResource Fog.Warn}" Fill="{DynamicResource Fog.WarnSoft}"
                                         AutomationProperties.Name="Loss over the last five minutes"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <Grid><TextBlock Text="SIGNAL (dBm)" Style="{StaticResource Fog.Overline}"/><TextBlock Text="{Binding RssiNow}" Style="{StaticResource Fog.Mono}" HorizontalAlignment="Right" FontSize="12"/></Grid>
                            <c:Sparkline Height="40" Values="{Binding RssiHistory}" Minimum="-100" Maximum="-30" Stroke="{DynamicResource Fog.Accent}" Fill="{DynamicResource Fog.AccentSoft}"
                                         AutomationProperties.Name="Signal over the last five minutes"/>
                        </StackPanel>
                        <StackPanel>
                            <Grid><TextBlock Text="TX FAIL RATE" Style="{StaticResource Fog.Overline}"/><TextBlock Text="{Binding FailNow}" Style="{StaticResource Fog.Mono}" HorizontalAlignment="Right" FontSize="12"/></Grid>
                            <c:Sparkline Height="40" Values="{Binding FailRateHistory}" Minimum="0" Stroke="{DynamicResource Fog.Bad}" Fill="{DynamicResource Fog.BadSoft}"
                                         AutomationProperties.Name="Unacknowledged frames per second"/>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="last 5 minutes" Style="{StaticResource Fog.Faint}" HorizontalAlignment="Right" FontSize="10.5"/>

                    <TextBlock Text="LINK (kept by the remote)" Style="{StaticResource MetricGroupTitle}"/>
                    <ItemsControl ItemsSource="{Binding Link.Items}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Grid Margin="0,2,0,6">
                        <TextBlock Text="THE TIMER'S OWN COUNTERS" Style="{StaticResource Fog.Overline}"/>
                        <TextBlock Text="{Binding TimerAgeText}" Style="{StaticResource Fog.Faint}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Timer.Items}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="The timer has not answered a counter request yet. It is polled in turn, one per second, while it is online."
                               Margin="0,0,0,2">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Fog.Caption}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTimer}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ChannelQualityRowViewModel}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ChannelText}" Style="{StaticResource Fog.Label}" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="{Binding TxText}" Style="{StaticResource Fog.Mono}"/>
                <TextBlock Grid.Column="2" Text="{Binding FailCountText}" Style="{StaticResource Fog.Mono}"/>
                <TextBlock Grid.Column="3" Text="{Binding FailText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Fog.Mono}">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="Warn"><Setter Property="Foreground" Value="{DynamicResource Fog.Warn}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Bad"><Setter Property="Foreground" Value="{DynamicResource Fog.Bad}"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="4" Text="{Binding RxText}" Style="{StaticResource Fog.Mono}"/>
                <ProgressBar Grid.Column="5" Minimum="0" Maximum="1" Value="{Binding BarFraction, Mode=OneWay}" Height="6" VerticalAlignment="Center" Margin="10,0,0,0"
                             ToolTip="Share of the traffic seen on this channel"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DiffRowViewModel}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Device}" Style="{StaticResource Fog.Label}"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Fog.Mono}"/>
                <TextBlock Grid.Column="2" Text="{Binding Baseline}" Style="{StaticResource Fog.MonoDim}"/>
                <TextBlock Grid.Column="3" Text="{Binding Current}" Style="{StaticResource Fog.Mono}"/>
                <TextBlock Grid.Column="4" Text="{Binding Delta}" Style="{StaticResource Fog.Mono}" FontWeight="SemiBold" Foreground="{DynamicResource Fog.Accent}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="24,18,24,28" MaxWidth="1400" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Diagnostics" Style="{StaticResource Fog.PageTitle}"/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Fog.Caption}"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Fog.Button.Small}" Content="Copy as JSON" Command="{Binding CopyJsonCommand}" Margin="0,0,6,0" ToolTip="Copy the latest counters, rates, verdicts and the channel table as JSON"/>
                    <Button Style="{StaticResource Fog.Button.Small}" Content="Export CSV..." Command="{Binding ExportCsvCommand}" Margin="0,0,6,0" ToolTip="One line per counter, with per-second rates"/>
                    <Button Style="{StaticResource Fog.Button.Small}" Content="Refresh now" Command="{Binding RefreshNowCommand}"/>
                </WrapPanel>
            </Grid>
            <TextBlock Style="{StaticResource Fog.PageSubtitle}" Margin="0,8,0,14"
                       Text="Every device counts what happens on its radio. Here you can see both ends of every link, the counters per second, and whether something looks wrong. The counter stream runs only while this page is open."/>

            <Border Style="{StaticResource Fog.Card}" Visibility="{Binding HasData, Converter={x:Static cv:Conv.InverseBoolToVisibility}}">
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Fog.DimBody}">
                            <Setter Property="Text" Value="Connect to a remote (or try the offline demo) to see its counters."/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Text" Value="Waiting for the first counters from the device..."/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <StackPanel Visibility="{Binding HasData, Converter={x:Static cv:Conv.BoolToVisibility}}">

                <!-- ===== the device itself ===== -->
                <Border Style="{StaticResource Fog.Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding RemoteTitle}" Style="{StaticResource Fog.Subtitle}" FontSize="16" VerticalAlignment="Top" Margin="0,2,18,0"/>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding RemoteChips}" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <StackPanel Grid.Column="2">
                                <Grid><TextBlock Text="TX FAIL RATE" Style="{StaticResource Fog.Overline}"/><TextBlock Text="{Binding RemoteFailNow}" Style="{StaticResource Fog.Mono}" HorizontalAlignment="Right" FontSize="12"/></Grid>
                                <c:Sparkline Height="30" Values="{Binding RemoteFailHistoryValues}" Minimum="0" Stroke="{DynamicResource Fog.Bad}" Fill="{DynamicResource Fog.BadSoft}"
                                             AutomationProperties.Name="Unacknowledged frames per second, last five minutes"/>
                            </StackPanel>
                        </Grid>
                        <!-- two columns of counter groups so the whole device fits on one screen -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="RADIO" Style="{StaticResource MetricGroupTitle}"/>
                                <ItemsControl ItemsSource="{Binding Radio.Items}" Focusable="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                                <StackPanel Visibility="{Binding IsDirectTimer, Converter={x:Static cv:Conv.InverseBoolToVisibility}}">
                                    <TextBlock Text="COMMANDS AND CHANNEL TOOLS" Style="{StaticResource MetricGroupTitle}"/>
                                    <ItemsControl ItemsSource="{Binding LinkSummary.Items}" Focusable="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                                </StackPanel>
                                <StackPanel Visibility="{Binding HasSelfTimer, Converter={x:Static cv:Conv.BoolToVisibility}}">
                                    <TextBlock Text="THE TIMER'S COUNTERS" Style="{StaticResource MetricGroupTitle}"/>
                                    <ItemsControl ItemsSource="{Binding SelfTimer.Items}" Focusable="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SYSTEM" Style="{StaticResource MetricGroupTitle}"/>
                                <ItemsControl ItemsSource="{Binding Sys.Items}" Focusable="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                                <TextBlock Text="RESETS SINCE THE DEVICE WAS FIRST STARTED" Style="{StaticResource MetricGroupTitle}"/>
                                <ItemsControl ItemsSource="{Binding Resets.Items}" Focusable="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                                <TextBlock Text="USB CONNECTION TO THIS PC" Style="{StaticResource MetricGroupTitle}"/>
                                <ItemsControl ItemsSource="{Binding Pc.Items}" Focusable="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== timers ===== -->
                <TextBlock Text="Timers" Style="{StaticResource Fog.Subtitle}" Margin="2,6,0,10" Visibility="{Binding HasDevices, Converter={x:Static cv:Conv.BoolToVisibility}}"/>
                <ItemsControl ItemsSource="{Binding Devices}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <c:ReflowPanel MinItemWidth="620" MaxItemWidth="2000" Spacing="14"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- ===== channel quality ===== -->
                <Border Style="{StaticResource Fog.Card}" Margin="0,14,0,14" Visibility="{Binding IsDirectTimer, Converter={x:Static cv:Conv.InverseBoolToVisibility}}">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="CHANNEL QUALITY OVER TIME" Style="{StaticResource Fog.Overline}"/>
                                <TextBlock Style="{StaticResource Fog.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None" MaxWidth="760"
                                           Text="Unicast frames the remote sent on each channel and how many were not acknowledged. The numbers accumulate while this app runs, so you can switch channels and compare them. Channel searches are not counted."/>
                            </StackPanel>
                            <Button Style="{StaticResource Fog.Button.Small}" Content="Reset" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding ResetChannelTableCommand}"
                                    ToolTip="Clear the accumulated numbers and start counting from now"/>
                        </Grid>
                        <Grid Margin="0,14,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Channel" Style="{StaticResource Fog.Faint}"/>
                            <TextBlock Grid.Column="1" Text="Sent" Style="{StaticResource Fog.Faint}"/>
                            <TextBlock Grid.Column="2" Text="Failed" Style="{StaticResource Fog.Faint}"/>
                            <TextBlock Grid.Column="3" Text="Fail %" Style="{StaticResource Fog.Faint}"/>
                            <TextBlock Grid.Column="4" Text="Received" Style="{StaticResource Fog.Faint}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ChannelRows}" Focusable="False"/>
                        <TextBlock Text="No channel data yet.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Fog.Caption}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasChannelRows}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ===== snapshot compare ===== -->
                <Border Style="{StaticResource Fog.Card}">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="SNAPSHOT COMPARE" Style="{StaticResource Fog.Overline}"/>
                                <TextBlock Text="{Binding BaselineText}" Style="{StaticResource Fog.Caption}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Style="{StaticResource Fog.Button.Small}" Content="Store baseline" Command="{Binding SetBaselineCommand}" Margin="0,0,6,0"
                                        ToolTip="Remember all counters now, then see what changed after you try something (move channel, move a timer ...)"/>
                                <Button Style="{StaticResource Fog.Button.Small}" Content="Clear" Command="{Binding ClearBaselineCommand}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,12,0,4" Visibility="{Binding HasBaseline, Converter={x:Static cv:Conv.BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/><ColumnDefinition Width="170"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Device" Style="{StaticResource Fog.Faint}"/>
                            <TextBlock Grid.Column="1" Text="Counter" Style="{StaticResource Fog.Faint}"/>
                            <TextBlock Grid.Column="2" Text="Baseline" Style="{StaticResource Fog.Faint}"/>
                            <TextBlock Grid.Column="3" Text="Now" Style="{StaticResource Fog.Faint}"/>
                            <TextBlock Grid.Column="4" Text="Change" Style="{StaticResource Fog.Faint}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding CompareRows}" Focusable="False"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
