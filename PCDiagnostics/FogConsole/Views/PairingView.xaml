<UserControl x:Class="FogConsole.Views.PairingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FogConsole.Controls"
             xmlns:cv="clr-namespace:FogConsole.Converters"
             xmlns:vm="clr-namespace:FogConsole.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="FoundTemplate" DataType="{x:Type vm:FoundDeviceViewModel}">
            <Border Style="{StaticResource Fog.Tile}" Margin="0,0,0,8" Padding="14,10">
                <Border.Resources>
                    <Style TargetType="Border" x:Key="Dimmer">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStale}" Value="True"><Setter Property="Opacity" Value="0.5"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Resources>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <c:SignalBars Width="24" Height="16" Bars="{Binding SignalBars}" OnBrush="{DynamicResource Fog.Ok}" OffBrush="{DynamicResource Fog.Track}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Rssi, StringFormat='{}{0} dBm'}" Style="{StaticResource Fog.MonoDim}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Fog.Subtitle}"/>
                            <TextBlock Text="{Binding TimesText}" Style="{StaticResource Fog.Faint}" Margin="12,2,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Fog.Faint}" FontFamily="{StaticResource Fog.MonoFont}">
                            <Run Text="{Binding Mac, Mode=OneWay}"/><Run Text="   boot "/><Run Text="{Binding Boot, Mode=OneWay}"/><Run Text="   heard "/><Run Text="{Binding AgeText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Border Style="{StaticResource Fog.Chip}" Margin="0,0,6,0" ToolTip="Radio channel the timer answered on">
                            <TextBlock Text="{Binding Channel, StringFormat='ch {0}'}" Style="{StaticResource Fog.ChipText}"/>
                        </Border>
                        <Border Style="{StaticResource Fog.Chip.Warn}" Margin="0,0,6,0" ToolTip="This timer is on another channel than the system. Pairing moves it to the system channel."
                                Visibility="{Binding OnOtherChannel, Converter={x:Static cv:Conv.BoolToVisibility}}">
                            <TextBlock Text="other channel" Style="{StaticResource Fog.ChipText.Warn}"/>
                        </Border>
                        <Border Style="{StaticResource Fog.Chip.Ok}" Visibility="{Binding IsPaired, Converter={x:Static cv:Conv.BoolToVisibility}}">
                            <TextBlock Text="paired" Style="{StaticResource Fog.ChipText.Ok}"/>
                        </Border>
                        <Border Style="{StaticResource Fog.Chip.Accent}" Visibility="{Binding IsPaired, Converter={x:Static cv:Conv.InverseBoolToVisibility}}">
                            <TextBlock Text="new" Style="{StaticResource Fog.ChipText.Accent}"/>
                        </Border>
                    </StackPanel>
                    <TextBox Grid.Column="3" Width="110" MaxLength="9" Text="{Binding PairName, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,8,0"
                             Visibility="{Binding IsPaired, Converter={x:Static cv:Conv.InverseBoolToVisibility}}" AutomationProperties.Name="Name for the new timer"
                             ToolTip="Name for the timer (1-9 characters)"/>
                    <Grid Grid.Column="4" VerticalAlignment="Center">
                        <Button Style="{StaticResource Fog.Button.Accent}" Content="Pair" MinWidth="86" Command="{Binding DataContext.PairCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                CommandParameter="{Binding}" Visibility="{Binding IsPaired, Converter={x:Static cv:Conv.InverseBoolToVisibility}}"
                                AutomationProperties.Name="Pair this timer"/>
                        <Button Style="{StaticResource Fog.Button}" Content="Unpair" MinWidth="86" Command="{Binding DataContext.UnpairFoundCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                CommandParameter="{Binding}" Visibility="{Binding IsPaired, Converter={x:Static cv:Conv.BoolToVisibility}}"
                                AutomationProperties.Name="Unpair this timer"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PairedTemplate" DataType="{x:Type vm:DeviceViewModel}">
            <Border Style="{StaticResource Fog.Tile}" Margin="0,0,0,8" Padding="14,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="14" Height="14" Fill="{Binding TagBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Fog.Subtitle}"/>
                        <TextBlock Style="{StaticResource Fog.Faint}" FontFamily="{StaticResource Fog.MonoFont}">
                            <Run Text="{Binding Mac, Mode=OneWay}"/><Run Text="   slot "/><Run Text="{Binding SlotId, Mode=OneWay}"/><Run Text="   ch "/><Run Text="{Binding Channel, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource Fog.Chip}" Margin="0,0,12,0" Background="{cv:ToneBrush Path=PillState, Part=Bg}" BorderBrush="{cv:ToneBrush Path=PillState, Part=Border}">
                        <TextBlock Text="{Binding PillText}" Style="{StaticResource Fog.ChipText}" Foreground="{cv:ToneBrush Path=PillState}"/>
                    </Border>
                    <Button Grid.Column="3" Style="{StaticResource Fog.Button}" Content="Unpair..." MinWidth="86"
                            Command="{Binding DataContext.UnpairCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="Unpair this timer"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" DataContext="{Binding}">
        <StackPanel Margin="24,18,24,28" MaxWidth="1200" HorizontalAlignment="Stretch">
            <TextBlock Text="Pairing" Style="{StaticResource Fog.PageTitle}"/>
            <TextBlock Style="{StaticResource Fog.PageSubtitle}"
                       Text="Search for smoke machine timers within radio range and pair them with the remote. Power up the timer first; a timer that is heating up or unplugged cannot be found."/>

            <!-- direct timer -->
            <Border Style="{StaticResource Fog.Card}" Visibility="{Binding IsDirectTimer, Converter={x:Static cv:Conv.BoolToVisibility}}">
                <TextBlock Style="{StaticResource Fog.Body}"
                           Text="A timer is connected directly by USB. Pairing, discovery and channel tools are functions of the remote and are not available here."/>
            </Border>

            <StackPanel Visibility="{Binding IsDirectTimer, Converter={x:Static cv:Conv.InverseBoolToVisibility}}">
                <!-- discover -->
                <Border Style="{StaticResource Fog.Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Style="{StaticResource Fog.ToggleButton}" IsChecked="{Binding DiscoverOn, Mode=TwoWay}" IsEnabled="{Binding CanDiscover}"
                                          Padding="22,11" FontSize="14" AutomationProperties.Name="Discover timers">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" Style="{StaticResource Fog.Icon}" FontSize="16" Margin="0,0,10,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Start discovery"/>
                                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DiscoverOn}" Value="True"><Setter Property="Text" Value="Discovering... (click to stop)"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </ToggleButton>
                            <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding Sweep}" Content="Also sweep other channels" IsEnabled="{Binding CanDiscover}"
                                          ToolTip="Hops through channels 1-13 to find timers that were left on another channel. Slower and more disruptive."/>
                            </StackPanel>
                        </Grid>
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,14,0,0"
                                     Visibility="{Binding DiscoverOn, Converter={x:Static cv:Conv.BoolToVisibility}}"/>
                        <TextBlock Style="{StaticResource Fog.Caption}" Margin="0,12,0,0" TextWrapping="Wrap" TextTrimming="None"
                                   Text="While discovery runs every timer in range is listed below, paired or not. Discovery stops automatically when you leave this page. With the sweep option the remote also listens on the other channels, which can take half a minute."/>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Fog.Subtitle}" Margin="2,24,0,10">
                    <Run Text="Timers heard"/>
                </TextBlock>
                <Border Style="{StaticResource Fog.Card}" Padding="18,14" Visibility="{Binding HasFound, Converter={x:Static cv:Conv.InverseBoolToVisibility}}">
                    <TextBlock Style="{StaticResource Fog.DimBody}" Text="Nothing yet. Press &quot;Start discovery&quot; and power on the timer you want to add."/>
                </Border>
                <ItemsControl ItemsSource="{Binding Found}" ItemTemplate="{StaticResource FoundTemplate}" Focusable="False"
                              Visibility="{Binding HasFound, Converter={x:Static cv:Conv.BoolToVisibility}}"/>

                <Grid Margin="2,26,0,10">
                    <TextBlock Text="Paired timers" Style="{StaticResource Fog.Subtitle}"/>
                    <TextBlock Text="{Binding CapacityText}" Style="{StaticResource Fog.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Border Padding="18,14">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Fog.Card}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Paired.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Style="{StaticResource Fog.DimBody}" Text="No timers are paired yet."/>
                </Border>
                <ItemsControl ItemsSource="{Binding Paired}" ItemTemplate="{StaticResource PairedTemplate}" Focusable="False"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
