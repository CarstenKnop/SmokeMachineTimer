<UserControl x:Class="FogConsole.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FogConsole.Controls"
             xmlns:cv="clr-namespace:FogConsole.Converters">
    <UserControl.Resources>
        <Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource Fog.Subtitle}">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Margin" Value="0,16,0,2"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="24,18,24,28" MaxWidth="920" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" Style="{StaticResource Fog.PageTitle}"/>
            <TextBlock Style="{StaticResource Fog.PageSubtitle}"
                       Text="Settings stored in the remote (they stay there when you disconnect), preferences of this application, and information about the connected device."/>

            <!-- ===== remote ===== -->
            <Border Style="{StaticResource Fog.Card}" Margin="0,0,0,16" Visibility="{Binding IsRemote, Converter={x:Static cv:Conv.BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="REMOTE" Style="{StaticResource Fog.Overline}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Fog.Button.Small}" Content="Reload" Command="{Binding ReloadCommand}" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource Fog.Button.Accent}" Content="Save to remote" Command="{Binding ApplyCommand}" Padding="16,6" FontSize="12.5"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Fog.Caption}" Margin="0,2,0,0"/>

                    <TextBlock Text="Radio transmit power" Style="{StaticResource SettingLabel}"/>
                    <TextBlock Text="Higher power reaches further but uses more battery. 21 dBm is the maximum." Style="{StaticResource Fog.Caption}"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                        <Slider Minimum="8" Maximum="84" TickFrequency="4" SmallChange="1" LargeChange="4" Value="{Binding TxPower}" IsEnabled="{Binding CanEdit}"
                                AutomationProperties.Name="Transmit power" IsSnapToTickEnabled="False"/>
                        <TextBlock Grid.Column="1" Text="{Binding TxPowerText}" Style="{StaticResource Fog.Mono}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Display brightness" Style="{StaticResource SettingLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                        <Slider Minimum="5" Maximum="255" SmallChange="1" LargeChange="20" Value="{Binding Brightness}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Display brightness"/>
                        <TextBlock Grid.Column="1" Text="{Binding Brightness}" Style="{StaticResource Fog.Mono}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Auto-off" Style="{StaticResource SettingLabel}"/>
                    <TextBlock Text="Seconds until the display blanks and the remote goes to deep sleep. 0 = never. While this PC is connected the remote stays awake anyway." Style="{StaticResource Fog.Caption}" TextWrapping="Wrap" TextTrimming="None"/>
                    <c:DecimalBox Value="{Binding AutoOff, Mode=TwoWay}" Minimum="0" Maximum="86400" Step="5" Decimals="0" Suffix="s" HorizontalAlignment="Left" Width="210" Margin="0,6,0,0"
                                  IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Auto-off seconds"/>

                    <TextBlock Text="Signal bars" Style="{StaticResource SettingLabel}"/>
                    <TextBlock Text="{Binding RssiHint}" Style="{StaticResource Fog.Caption}"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="0 bars at" Style="{StaticResource Fog.Label}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="-110" Maximum="-60" Value="{Binding RssiLow}" IsEnabled="{Binding CanEdit}" SmallChange="1" LargeChange="5" AutomationProperties.Name="Weakest signal, 0 bars"/>
                        <TextBlock Grid.Column="2" Text="{Binding RssiLow, StringFormat='{}{0} dBm'}" Style="{StaticResource Fog.Mono}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Text="6 bars at" Style="{StaticResource Fog.Label}" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="-80" Maximum="-30" Value="{Binding RssiHigh}" IsEnabled="{Binding CanEdit}" SmallChange="1" LargeChange="5" Margin="0,6,0,0" AutomationProperties.Name="Strongest signal, 6 bars"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding RssiHigh, StringFormat='{}{0} dBm'}" Style="{StaticResource Fog.Mono}" Margin="14,6,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Battery calibration" Style="{StaticResource SettingLabel}"/>
                    <TextBlock Text="{Binding BatHint}" Style="{StaticResource Fog.Caption}"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="0 % (empty)" Style="{StaticResource Fog.Faint}" Margin="0,0,0,3"/>
                            <c:DecimalBox Value="{Binding BatCal0, Mode=TwoWay}" Minimum="2000" Maximum="5000" Step="10" Decimals="0" Suffix="mV" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Battery 0 percent millivolts"/>
                            <Button Style="{StaticResource Fog.Button.Subtle}" Content="Use live voltage" FontSize="11.5" Padding="6,3" Command="{Binding UseLiveAsCommand}" CommandParameter="0" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="50 %" Style="{StaticResource Fog.Faint}" Margin="0,0,0,3"/>
                            <c:DecimalBox Value="{Binding BatCal50, Mode=TwoWay}" Minimum="2000" Maximum="5000" Step="10" Decimals="0" Suffix="mV" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Battery 50 percent millivolts"/>
                            <Button Style="{StaticResource Fog.Button.Subtle}" Content="Use live voltage" FontSize="11.5" Padding="6,3" Command="{Binding UseLiveAsCommand}" CommandParameter="50" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="100 % (full)" Style="{StaticResource Fog.Faint}" Margin="0,0,0,3"/>
                            <c:DecimalBox Value="{Binding BatCal100, Mode=TwoWay}" Minimum="2000" Maximum="5000" Step="10" Decimals="0" Suffix="mV" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Battery 100 percent millivolts"/>
                            <Button Style="{StaticResource Fog.Button.Subtle}" Content="Use live voltage" FontSize="11.5" Padding="6,3" Command="{Binding UseLiveAsCommand}" CommandParameter="100" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Fog.Caption}" Margin="0,6,0,0">
                        <Run Text="Live battery voltage right now: "/><Run Text="{Binding LiveMillivolts, Mode=OneWay}" FontWeight="SemiBold" FontFamily="{StaticResource Fog.MonoFont}"/><Run Text=" mV. Let the battery rest at the matching charge level, then press &quot;Use live voltage&quot; for that point."/>
                    </TextBlock>

                    <TextBlock Text="Network id" Style="{StaticResource SettingLabel}"/>
                    <TextBlock Style="{StaticResource Fog.Caption}" TextWrapping="Wrap" TextTrimming="None">
                        <Run Text="{Binding Net, Mode=OneWay}" FontWeight="SemiBold" FontFamily="{StaticResource Fog.MonoFont}"/><Run Text="  - read only here. Changing it requires pairing every timer again, so it is deliberately not editable."/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ===== direct timer ===== -->
            <Border Style="{StaticResource Fog.Card}" Margin="0,0,0,16" Visibility="{Binding IsTimer, Converter={x:Static cv:Conv.BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="TIMER (CONNECTED BY USB)" Style="{StaticResource Fog.Overline}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Fog.Button.Small}" Content="Reload" Command="{Binding ReloadCommand}" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource Fog.Button.Accent}" Content="Save to timer" Command="{Binding ApplyCommand}" Padding="16,6" FontSize="12.5"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Fog.Caption}" Margin="0,2,0,0"/>
                    <TextBlock Text="Name" Style="{StaticResource SettingLabel}"/>
                    <TextBox Text="{Binding TimerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" Width="220" HorizontalAlignment="Left" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Timer name"/>
                    <TextBlock Text="Durations" Style="{StaticResource SettingLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ON" Style="{StaticResource Fog.Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <c:DecimalBox Value="{Binding TimerOn, Mode=TwoWay}" Width="170" IsEnabled="{Binding CanEdit}"/>
                        <TextBlock Text="OFF" Style="{StaticResource Fog.Label}" VerticalAlignment="Center" Margin="22,0,8,0"/>
                        <c:DecimalBox Value="{Binding TimerOff, Mode=TwoWay}" Width="170" IsEnabled="{Binding CanEdit}"/>
                    </StackPanel>
                    <TextBlock Text="Start phase after power-up" Style="{StaticResource SettingLabel}"/>
                    <ComboBox ItemsSource="{Binding StartPhases}" SelectedIndex="{Binding TimerStartPhaseIndex}" Width="220" HorizontalAlignment="Left" IsEnabled="{Binding CanEdit}"/>
                    <CheckBox Content="Status LED enabled" IsChecked="{Binding TimerLed}" Margin="0,16,0,0" IsEnabled="{Binding CanEdit}"/>
                </StackPanel>
            </Border>

            <!-- ===== preferences ===== -->
            <Border Style="{StaticResource Fog.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="THIS APPLICATION" Style="{StaticResource Fog.Overline}"/>
                    <TextBlock Text="Theme" Style="{StaticResource SettingLabel}"/>
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="220" HorizontalAlignment="Left" AutomationProperties.Name="Theme"/>
                    <TextBlock Text="System follows the Windows light / dark setting." Style="{StaticResource Fog.Caption}" Margin="0,4,0,0"/>

                    <CheckBox Content="Connect automatically to the last port at startup" IsChecked="{Binding AutoConnect}" Margin="0,18,0,0"/>
                    <CheckBox Content="Reconnect automatically when the device disappears and comes back (reboot, deep sleep, cable)" IsChecked="{Binding AutoReconnect}" Margin="0,10,0,0"/>

                    <TextBlock Text="Buffers" Style="{StaticResource SettingLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Log / raw lines kept" Style="{StaticResource Fog.Faint}" Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding BufferSizes}" SelectedItem="{Binding LogBufferSize}" Width="140" AutomationProperties.Name="Log buffer size"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Packets kept" Style="{StaticResource Fog.Faint}" Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding BufferSizes}" SelectedItem="{Binding PacketBufferSize}" Width="140" AutomationProperties.Name="Packet buffer size"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Simulator" Style="{StaticResource SettingLabel}"/>
                    <ComboBox ItemsSource="{Binding SimulatorKinds}" SelectedIndex="{Binding SimKindIndex}" Width="260" HorizontalAlignment="Left" AutomationProperties.Name="Simulator kind"/>
                    <TextBlock Text="What the offline demo pretends to be. Takes effect the next time the simulator starts." Style="{StaticResource Fog.Caption}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ===== about ===== -->
            <Border Style="{StaticResource Fog.Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="ABOUT" Style="{StaticResource Fog.Overline}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource Fog.Button.Small}" Content="Open data folder" Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Right"
                                ToolTip="Settings and crash log"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding About}" Margin="0,10,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Item1}" Style="{StaticResource Fog.Caption}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Item2}" Style="{StaticResource Fog.Label}" TextWrapping="Wrap" TextTrimming="None" IsHitTestVisible="True"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
