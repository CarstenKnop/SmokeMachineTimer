<UserControl x:Class="FogConsole.Views.SimulatorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:FogConsole.Converters">
    <Border Background="{DynamicResource Fog.SurfaceRaised}" BorderBrush="{DynamicResource Fog.Sim}" BorderThickness="1.5" CornerRadius="12" Padding="20" Width="400"
            AutomationProperties.Name="Simulator demo controls">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45"/></Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7F8;" Style="{StaticResource Fog.Icon}" Foreground="{DynamicResource Fog.Sim}" FontSize="18" Margin="0,0,10,0"/>
                <TextBlock Text="Simulator - demo controls" Style="{StaticResource Fog.Subtitle}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Fog.DimBody}" Margin="0,6,0,14"
                       Text="Everything is virtual. Use these controls to provoke the situations you will meet with real machines."/>

            <TextBlock Text="SCENARIO" Style="{StaticResource Fog.Overline}"/>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Timers" Style="{StaticResource Fog.Label}" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                        Value="{Binding TimerCount, Mode=TwoWay}" AutomationProperties.Name="Number of simulated timers"/>
                <TextBlock Grid.Column="2" Text="{Binding TimerCount}" Style="{StaticResource Fog.Mono}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Random seed" Style="{StaticResource Fog.Label}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding Sim.Seed, UpdateSourceTrigger=LostFocus}" FontFamily="{StaticResource Fog.MonoFont}"
                         AutomationProperties.Name="Random seed" ToolTip="The same seed with the same actions always replays the same story."/>
                <Button Grid.Column="2" Style="{StaticResource Fog.Button.Small}" Content="New seed" Margin="8,0,0,0" Command="{Binding NewSeedCommand}"/>
            </Grid>
            <Button Style="{StaticResource Fog.Button.Accent}" Content="Restart simulator with these settings" Margin="0,12,0,0" Command="{Binding RestartCommand}"
                    ToolTip="Starts a fresh simulation (new timers, new random story)"/>

            <Rectangle Style="{StaticResource Fog.Separator}" Margin="0,16"/>
            <TextBlock Text="PROVOKE" Style="{StaticResource Fog.Overline}"/>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Packet loss" Style="{StaticResource Fog.Label}" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" Minimum="0" Maximum="60" TickFrequency="5" TickPlacement="BottomRight" IsSnapToTickEnabled="False"
                        Value="{Binding Sim.LossPercent, Mode=TwoWay}" AutomationProperties.Name="Extra packet loss in percent"/>
                <TextBlock Grid.Column="2" Text="{Binding Sim.LossPercent, StringFormat='+{0:0}%'}" Style="{StaticResource Fog.Mono}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding CutTarget}" DisplayMemberPath="DisplayName"
                          AutomationProperties.Name="Timer to cut power to" ToolTip="Which timer loses power (default: the selected one)"/>
                <Button Grid.Column="1" Style="{StaticResource Fog.Button.Small}" Content="Cut power for 30 s" Margin="8,0,0,0" Command="{Binding CutPowerCommand}"
                        ToolTip="Like a smoke machine that heats up and takes its timer's power: it goes offline and comes back with boot+1."/>
            </Grid>

            <Button Style="{StaticResource Fog.Button.Small}" Content="Inject interference on the current channel (60 s)" Margin="0,10,0,0" Command="{Binding InterfereCommand}"
                    HorizontalAlignment="Stretch" ToolTip="A jammer appears on the channel in use: more packets get lost. Run a survey and move to a quieter channel."/>

            <Button Style="{StaticResource Fog.Button.Small}" Margin="0,10,0,0" Command="{Binding TogglePauseCommand}" HorizontalAlignment="Stretch"
                    ToolTip="Freezes simulated time: nothing changes until you resume (handy for screenshots).">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding PauseGlyph}" Style="{StaticResource Fog.Icon}" FontSize="13" Margin="0,0,8,0"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <TextBlock Text="{Binding PauseText}"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
